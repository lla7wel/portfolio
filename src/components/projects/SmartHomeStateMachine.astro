---
/* Smart Home — accessible state-machine visual. Transitions shown are
   exactly the ones the repository documents: power-on → AUTO; button 1
   cycles AUTO → MANUAL → SLEEP → AUTO; ALARM overrides any mode at ≥35 °C
   and releases when the temperature falls. */
import { type Locale } from "../../lib/i18n";
import StageExplainerShell from "./StageExplainerShell.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ar = locale === "ar";

const stages = [
  {
    id: "auto",
    code: "AUTO",
    label: ar ? "تلقائي" : "AUTO",
    detail: ar
      ? "وضع الإقلاع. تُترجم قراءة DHT11 إلى منحنى سرعة مروحة عبر PWM: إيقاف تحت 24°، ثم منخفض فمتوسط، وكامل من 28°."
      : "The power-on mode. The DHT11 reading maps to a PWM fan curve: off below 24 °C, then low and medium bands, full from 28 °C.",
  },
  {
    id: "manual",
    code: "MAN",
    label: ar ? "يدوي" : "MANUAL",
    detail: ar
      ? "الزر الأول ينقل من التلقائي إلى اليدوي؛ الزر الثاني يبدّل سرعة المروحة: إيقاف ← منخفض ← متوسط ← كامل."
      : "Button 1 moves from AUTO to MANUAL; button 2 cycles the fan OFF → LOW → MEDIUM → FULL.",
  },
  {
    id: "sleep",
    code: "SLP",
    label: ar ? "سكون" : "SLEEP",
    detail: ar
      ? "المروحة متوقفة، ويتحول المؤشر الأزرق إلى إضاءة ليلية تكيفية تعتمد على قراءة مستشعر الضوء."
      : "Fan off; the blue LED becomes an adaptive nightlight driven by the LDR reading.",
  },
  {
    id: "alarm",
    code: "ALM",
    label: ar ? "إنذار" : "ALARM",
    detail: ar
      ? "عند 35° أو أكثر يتجاوز الإنذار أي وضع: تُقطع المروحة، وتصدر الصافرة صوتًا، ويضيء المؤشر الأحمر حتى تنخفض الحرارة."
      : "At ≥ 35 °C the alarm overrides any mode: the fan is cut, the buzzer sounds, and the red LED stays lit until the temperature falls.",
  },
];
---

<div class="shsm" data-project="smart-home-controller" data-explainer-scope>
  <svg viewBox="0 0 620 300" aria-hidden="true" class="machine">
    {/* power-on entry */}
    <g data-segment="auto">
      <line x1="60" y1="60" x2="128" y2="60" class="tr" marker-end="url(#shsm-arrow)" />
      <text x="58" y="48" class="tr-label mono">POWER-ON</text>
    </g>
    <defs>
      <marker id="shsm-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L8 4L0 8z" class="arrow-head" />
      </marker>
    </defs>

    {/* Mode cycle: AUTO → MANUAL → SLEEP → AUTO (button 1) */}
    <g data-segment="auto">
      <rect x="130" y="34" width="120" height="52" rx="8" class="state" />
      <text x="190" y="65" text-anchor="middle" class="st-label mono">AUTO</text>
    </g>
    <g data-segment="manual">
      <rect x="370" y="34" width="120" height="52" rx="8" class="state" />
      <text x="430" y="65" text-anchor="middle" class="st-label mono">MANUAL</text>
    </g>
    <g data-segment="sleep">
      <rect x="250" y="150" width="120" height="52" rx="8" class="state" />
      <text x="310" y="181" text-anchor="middle" class="st-label mono">SLEEP</text>
    </g>
    <g data-segment="alarm">
      <rect x="250" y="236" width="120" height="52" rx="8" class="state alarm" />
      <text x="310" y="267" text-anchor="middle" class="st-label mono">ALARM</text>
    </g>

    <g data-segment="auto manual">
      <line x1="250" y1="60" x2="368" y2="60" class="tr" marker-end="url(#shsm-arrow)" />
      <text x="309" y="48" text-anchor="middle" class="tr-label mono">BTN1</text>
    </g>
    <g data-segment="manual sleep">
      <line x1="430" y1="86" x2="372" y2="160" class="tr" marker-end="url(#shsm-arrow)" />
      <text x="425" y="130" class="tr-label mono">BTN1</text>
    </g>
    <g data-segment="sleep auto">
      <line x1="250" y1="160" x2="190" y2="88" class="tr" marker-end="url(#shsm-arrow)" />
      <text x="176" y="130" class="tr-label mono">BTN1</text>
    </g>
    {/* Alarm override + release */}
    <g data-segment="alarm">
      <line x1="140" y1="86" x2="248" y2="252" class="tr danger" marker-end="url(#shsm-arrow)" />
      <line x1="490" y1="86" x2="372" y2="252" class="tr danger" marker-end="url(#shsm-arrow)" />
      <text x="120" y="180" class="tr-label mono danger-t">≥35°C</text>
      <text x="470" y="180" class="tr-label mono danger-t">≥35°C</text>
      <line x1="310" y1="236" x2="222" y2="90" class="tr release" marker-end="url(#shsm-arrow)" />
      <text x="236" y="170" class="tr-label mono">TEMP↓</text>
    </g>
  </svg>

  <StageExplainerShell
    locale={locale}
    title={ar ? "آلة الحالات ذات الأوضاع الأربعة" : "The four-mode state machine"}
    stages={stages}
    diagramText={ar
      ? "مخطط حالات: التشغيل يبدأ في التلقائي؛ الزر الأول يدور بين تلقائي ويدوي وسكون؛ والإنذار يتجاوز أي وضع عند 35 درجة ويعود عند انخفاض الحرارة."
      : "State diagram: power-on starts in AUTO; button 1 cycles AUTO, MANUAL, SLEEP; ALARM overrides any mode at 35 degrees and releases when the temperature falls."}
  />
</div>

<style>
  .shsm {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .machine {
    inline-size: 100%;
    max-inline-size: 40rem;
    block-size: auto;
    margin-inline: auto;
  }
  .state {
    fill: var(--color-surface-raised);
    stroke: var(--color-rule-strong);
    stroke-width: 1.5;
    transition: stroke var(--dur-control) var(--ease-technical);
  }
  .state.alarm {
    stroke: var(--accent-3, var(--color-danger));
    stroke-dasharray: 4 3;
  }
  g.is-active .state {
    stroke: var(--accent, var(--color-trace));
    stroke-width: 2.5;
  }
  g.is-active .state.alarm {
    stroke: var(--accent-3, var(--color-danger));
    stroke-dasharray: none;
  }
  .st-label {
    font-size: 14px;
    letter-spacing: 0.12em;
    fill: var(--color-ink);
  }
  .tr {
    stroke: var(--color-rule-strong);
    stroke-width: 1.5;
    transition: stroke var(--dur-control) var(--ease-technical);
  }
  .tr.danger {
    stroke: color-mix(in oklab, var(--accent-3, var(--color-danger)) 60%, var(--color-rule-strong));
  }
  g.is-active .tr {
    stroke: var(--accent, var(--color-trace));
    stroke-width: 2.5;
  }
  g.is-active .tr.danger,
  g.is-active .tr.release {
    stroke: var(--accent-3, var(--color-danger));
  }
  .arrow-head {
    fill: var(--color-rule-strong);
  }
  .tr-label {
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--color-ink-muted);
  }
  .danger-t {
    fill: var(--accent-3, var(--color-danger));
  }
</style>
