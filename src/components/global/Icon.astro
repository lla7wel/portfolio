---
/** Original inline SVG icon set — consistent 1.5px stroke, 24px grid. */
interface Props {
  name:
    | "menu"
    | "close"
    | "theme"
    | "language"
    | "external"
    | "github"
    | "linkedin"
    | "email"
    | "prev"
    | "next"
    | "expand"
    | "play"
    | "pause"
    | "info"
    | "copy"
    | "arrow";
  class?: string;
}
const { name, class: className = "icon" } = Astro.props;

const paths: Record<Props["name"], string> = {
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
  theme: "M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z",
  language: "M4 6h9M8.5 3v3M6 6c1.5 4.5 4.5 8 8 10M11 6c-1.5 4.5-4.5 8-8 10M14 21l4-9 4 9M15.5 17.5h5",
  external: "M14 5h5v5M19 5l-8 8M11 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5",
  github:
    "M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44v-1.7c-2.5.55-3.03-1.06-3.03-1.06-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.11.98 2.63.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.08-2.4 0 0 .76-.24 2.48.92a8.6 8.6 0 0 1 4.51 0c1.72-1.16 2.47-.92 2.47-.92.49 1.25.18 2.17.1 2.4.57.63.92 1.44.92 2.42 0 3.47-2.11 4.22-4.12 4.44.32.28.61.83.61 1.67v2.47c0 .24.16.53.62.44A9 9 0 0 0 12 3Z",
  linkedin:
    "M6.5 9.5v8M6.5 6.6v.01M11 17.5v-4.7a2.75 2.75 0 0 1 5.5 0v4.7M11 9.5v1.2M4 4h16v16H4z",
  email: "M4 6h16v12H4zM4 7l8 6 8-6",
  prev: "M15 5l-7 7 7 7",
  next: "M9 5l7 7-7 7",
  expand: "M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5",
  play: "M8 5.5v13l11-6.5-11-6.5Z",
  pause: "M8 5v14M16 5v14",
  info: "M12 11v6M12 7.5v.01M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z",
  copy: "M9 9h11v11H9zM5 15H4V4h11v1",
  arrow: "M4 12h16M13 5l7 7-7 7",
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-icon={name}
>
  <path d={paths[name]} fill={name === "github" || name === "play" ? "currentColor" : "none"} stroke={name === "github" ? "none" : "currentColor"}></path>
</svg>

<style>
  /* Directional icons mirror in RTL: reading-order arrows follow text flow. */
  :global([dir="rtl"]) svg[data-icon="arrow"],
  :global([dir="rtl"]) svg[data-icon="prev"],
  :global([dir="rtl"]) svg[data-icon="next"] {
    transform: scaleX(-1);
  }
</style>
