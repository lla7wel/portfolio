---
import "../styles/global.css";
import sansLatin400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import sansLatin600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import sansArabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import sansArabic600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url";
import {
  type Locale,
  t,
  dirFor,
  switchLocalePath,
} from "../lib/i18n";
import SiteHeader from "../components/global/SiteHeader.astro";
import SiteFooter from "../components/global/SiteFooter.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** JSON-LD object(s), already truth-checked against the claim registry. */
  jsonLd?: object | object[];
  /** Absolute-path OG image (1200×630); defaults to the site card. */
  ogImage?: string;
  /** Optional mono route label shown in the desktop header, e.g. "SYS-01". */
  routeLabel?: string;
}

const { locale, title, description, jsonLd, ogImage, routeLabel } = Astro.props;
const dir = dirFor(locale);
const pageTitle = title ? `${title} — ${t(locale, "hero.name")}` : t(locale, "site.title");
const pageDescription = description ?? t(locale, "site.description");
const pathname = Astro.url.pathname;
// The 404 page renders at arbitrary URLs; send its locale switch home.
const altPath = pathname.startsWith("/404")
  ? (locale === "ar" ? "/en/" : "/ar/")
  : switchLocalePath(locale, pathname);
const enUrl = new URL(locale === "en" ? pathname : altPath, Astro.site);
const arUrl = new URL(locale === "ar" ? pathname : altPath, Astro.site);
const canonical = new URL(pathname, Astro.site);
const ogImageUrl = new URL(ogImage ?? "/og/default.png", Astro.site);
// Body face + the heading weight (measured: h1 at 600 drives mobile LCP).
const bodyFont = locale === "ar" ? sansArabic400 : sansLatin400;
const displayFont = locale === "ar" ? sansArabic600 : sansLatin600;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f2ec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090d0f" />
    <meta name="theme-color" content="#f4f2ec" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === "ar" ? "ar" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "ar" ? "en_US" : "ar"} />
    <meta property="og:site_name" content={t(locale, "hero.name")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <script is:inline>
      // Theme: honor stored choice pre-paint; default follows system.
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "nav.skip")}</a>
    <SiteHeader locale={locale} altPath={altPath} routeLabel={routeLabel} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} altPath={altPath} />
    <div
      id="a11y-announcer"
      class="visually-hidden"
      aria-live="polite"
      data-dark={t(locale, "theme.dark")}
      data-light={t(locale, "theme.light")}
    >
    </div>
    <script>
      import { initTheme } from "../scripts/theme";
      import { initMobileNavigation } from "../scripts/mobile-navigation";
      initTheme();
      initMobileNavigation();
    </script>
  </body>
</html>

