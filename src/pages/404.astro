---
import Base from "../layouts/Base.astro";
import { t } from "../lib/i18n";
// 404 renders in English with an Arabic line — static hosts serve one 404.
---

<Base locale="en" title={t("en", "notFound.title")}>
  <div class="measure">
    <h1>{t("en", "notFound.title")}</h1>
    <p>{t("en", "notFound.body")}</p>
    <p lang="ar" dir="rtl">{t("ar", "notFound.body")}</p>
    <p>
      <a href="/en/">{t("en", "notFound.home")}</a> ·
      <a href="/ar/" lang="ar" dir="rtl">{t("ar", "notFound.home")}</a>
    </p>
  </div>
</Base>
