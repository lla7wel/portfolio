---
import Base from "../../../layouts/Base.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { type Locale, t } from "../../../lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "ar" } }];
}

const locale = Astro.params.locale as Locale;
const projects = (await getCollection("projects", (p) => p.data.locale === locale))
  .sort((a, b) => a.data.order - b.data.order);
const flagships = projects.filter((p) => p.data.tier === "flagship");
const supporting = projects.filter((p) => p.data.tier === "supporting");

// Archive entries (plan §13): dated text list, no cards, no padding.
const archive =
  locale === "ar"
    ? [
        "2024 — روبوتات micro:bit / Maqueen: تتبع الخط وتفادي العوائق",
        "2024 — Micro Chat: اتصال لاسلكي بين أجهزة micro:bit",
        "2025 — بناء نسخة سابقة من موقع Mersal International (استُبدلت لاحقًا بموقع الشركة الحالي)",
        "2025 — Kaziony: تصميم أولي لخدمة توصيل (مفهوم منتج)",
        "2026 — نماذج تصميم ملحقات تنقّل (CAD/Blender)",
      ]
    : [
        "2024 — micro:bit / Maqueen robotics: line following & obstacle detection",
        "2024 — Micro Chat: micro:bit radio communication",
        "2025 — built an earlier version of the Mersal International website, since replaced by the company's current site",
        "2025 — Kaziony: delivery-service product concept",
        "2026 — mobility-accessory design mockups (CAD/Blender)",
      ];
---

<Base locale={locale} title={t(locale, "nav.work")}>
  <div class="measure">
    <h1>{t(locale, "work.all")}</h1>

    <h2>{t(locale, "work.flagship")}</h2>
    <div style="display:grid; gap:1rem;">
      {
        flagships.map((p) => (
          <ProjectCard
            locale={locale}
            slug={p.data.key}
            title={p.data.title}
            outcome={p.data.outcome}
            status={p.data.status}
            stack={p.data.stack}
            headingLevel="h3"
          />
        ))
      }
    </div>

    <h2>{t(locale, "work.supporting")}</h2>
    <div style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));">
      {
        supporting.map((p) => (
          <ProjectCard
            locale={locale}
            slug={p.data.key}
            title={p.data.title}
            outcome={p.data.outcome}
            status={p.data.status}
            stack={p.data.stack}
            headingLevel="h3"
          />
        ))
      }
    </div>

    <h2>{t(locale, "work.archive")}</h2>
    <ul style="color:var(--ink-muted);">
      {archive.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</Base>
